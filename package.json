{
  "name": "just-upload",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Uploads that just work. When a website says no to your upload, Just Upload quietly fixes it, privately, on your device.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "pnpm notices && wxt build",
    "build:edge": "pnpm notices && wxt build -b edge",
    "zip": "pnpm notices && wxt zip",
    "zip:edge": "pnpm notices && wxt zip -b edge",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:site": "vite --config test-site/vite.config.ts",
    "test:e2e": "pnpm build && playwright test",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e",
    "notices": "node scripts/build-notices.mjs",
    "postinstall": "wxt prepare",
    "screenshots": "node scripts/store-screenshots.mjs",
    "real-sites": "pnpm build && node scripts/real-sites.mjs"
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "@jsquash/jxl": "1.3.0",
    "framer-motion": "13.4.6",
    "gifenc": "1.0.3",
    "libheif-js": "1.23.2",
    "pako": "1.0.11",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pica": "10.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "utif2": "4.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/pako": "^1.0.7",
    "@types/pica": "9.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "dropzone": "6.3.5",
    "eslint": "10.11.0",
    "filepond": "4.32.12",
    "happy-dom": "20.14.5",
    "prettier": "3.9.9",
    "react-dropzone": "20.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wxt": "0.21.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core"
    ]
  }
}
